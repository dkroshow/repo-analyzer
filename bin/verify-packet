#!/usr/bin/env python3
"""Verify an analyze-repo packet against its clone. Exit 0 on pass, 1 on fail.

Usage: verify-packet <data/<repo>> [--min-anchor-rate 0.95]

Checks, in order:
  1. Packet shape: analysis/README.md plus one each of
     current-understanding-*.md, source-map-*.md, install-and-setup-*.md.
  2. Pinned SHA: every page names the clone's HEAD commit (short or full).
  3. Anchors: every `../clone/<path>:<line>` link resolves to an existing file
     with that many lines at HEAD. GitHub-style URLs to the same repo count as
     failures. The pass rate must meet --min-anchor-rate.
  4. Coverage contract: every subsystem `repo-signals` reports is named in the
     README's "Coverage Contract" table, unless it is auto_waivable.

Prints one line per failure and a summary. No dependencies beyond stdlib;
needs `git` and `repo-signals` (same directory as this script, or on PATH).
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys

REQUIRED_PAGES = ['current-understanding-*.md', 'source-map-*.md',
                  'install-and-setup-*.md']
ANCHOR_RE = re.compile(r'\]\((?:\.\./)+clone/([^)#\s]+?)(?::(\d+))?\)')
GITHUB_RE = re.compile(r'https?://(?:github|gitlab)\.com/[^\s)]+/blob/')


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def line_count(path):
    with open(path, 'rb') as fh:
        data = fh.read()
    if not data:
        return 0
    return data.count(b'\n') + (0 if data.endswith(b'\n') else 1)


def main():
    argv = sys.argv[1:]
    min_rate = 0.95
    if '--min-anchor-rate' in argv:
        i = argv.index('--min-anchor-rate')
        min_rate = float(argv[i + 1])
        del argv[i:i + 2]
    args = [a for a in argv if not a.startswith('--')]
    if len(args) != 1:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    root = os.path.abspath(args[0])
    analysis, clone = os.path.join(root, 'analysis'), os.path.join(root, 'clone')
    failures = []

    # 1. Shape
    pages = sorted(glob.glob(os.path.join(analysis, '*.md')))
    if not os.path.isfile(os.path.join(analysis, 'README.md')):
        failures.append('shape: analysis/README.md missing')
    for pattern in REQUIRED_PAGES:
        if not glob.glob(os.path.join(analysis, pattern)):
            failures.append(f'shape: no page matching {pattern}')
    if not os.path.isdir(os.path.join(clone, '.git')):
        failures.append('shape: clone/ is not a git checkout')
        report(failures, pages, 0, 0)

    # 2. Pinned SHA
    sha = run(['git', '-C', clone, 'rev-parse', 'HEAD']).strip()
    for page in pages:
        text = open(page, encoding='utf-8', errors='replace').read()
        if sha not in text and sha[:7] not in text:
            failures.append(f'sha: {os.path.basename(page)} does not name HEAD {sha[:7]}')

    # 3. Anchors. Individual misses are listed; the packet fails on the rate,
    # or on any hosted URL.
    total = ok = 0
    misses = []
    for page in pages:
        name = os.path.basename(page)
        text = open(page, encoding='utf-8', errors='replace').read()
        for m in GITHUB_RE.finditer(text):
            total += 1
            failures.append(f'anchor: {name} uses a hosted URL: {m.group(0)}...')
        for m in ANCHOR_RE.finditer(text):
            total += 1
            rel, line = m.group(1), m.group(2)
            target = os.path.normpath(os.path.join(clone, rel))
            if not target.startswith(clone + os.sep) or not os.path.isfile(target):
                misses.append(f'{name} -> {rel}: file not found')
                continue
            if line and int(line) > line_count(target):
                misses.append(f'{name} -> {rel}:{line}: past end of file')
                continue
            ok += 1
    for m in misses:
        print('MISS anchor:', m)
    rate = ok / total if total else 1.0
    if total and rate < min_rate:
        failures.append(f'anchor: resolution {ok}/{total} = {rate:.2f} below {min_rate}')

    # 4. Coverage contract
    signals_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'repo-signals')
    if not os.path.isfile(signals_bin):
        signals_bin = shutil.which('repo-signals')
    if signals_bin:
        signals = json.loads(run([signals_bin, clone]))
        readme = open(os.path.join(analysis, 'README.md'), encoding='utf-8',
                      errors='replace').read() if os.path.isfile(
            os.path.join(analysis, 'README.md')) else ''
        section = readme.split('## Coverage Contract', 1)
        table = section[1].split('\n## ', 1)[0] if len(section) == 2 else ''
        if not table:
            failures.append('coverage: README.md has no "## Coverage Contract" section')
        listed = set(re.findall(r'^\|\s*`([^`]+)`', table, re.M))
        for sub in signals.get('subsystems', []):
            if sub.get('auto_waivable'):
                continue
            if sub['path'] not in listed:
                failures.append(f"coverage: subsystem `{sub['path']}` "
                                f"({sub['files']} files) not in the contract table")
    else:
        failures.append('coverage: repo-signals not found; contract not checked')

    report(failures, pages, ok, total)


def report(failures, pages, ok, total):
    for f in failures:
        print('FAIL', f)
    print(f'{len(pages)} pages, anchors {ok}/{total} resolved, '
          f'{len(failures)} failure(s): {"FAIL" if failures else "PASS"}')
    sys.exit(1 if failures else 0)


if __name__ == '__main__':
    main()
